      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET_06_Consultas_Criticas" enabled="true">
          <stringProp name="HTTPSampler.path">/api/lugares?q=zona&amp;page=0&amp;size=20</stringProp>
