# ============================================================
# LocalSpot Backend - Variables de entorno (ejemplo)
# Copia este archivo como .env y ajusta los valores.
# ============================================================

# Base de datos PostgreSQL
POSTGRES_DB=localspot
POSTGRES_USER=localspot
POSTGRES_PASSWORD=localspot123
POSTGRES_PORT=15432

# pgAdmin
PGADMIN_EMAIL=admin@localspot.test
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=15050

# Backend
BACKEND_PORT=18080

# JWT
JWT_SECRET=localspot-super-secret-key-12345678901234567890123456789012
JWT_EXPIRATION=86400000

# Administrador inicial (se crea automaticamente al arrancar)
ADMIN_EMAIL=admin@localspot.test
ADMIN_PASSWORD=Admin123456

# Almacenamiento de archivos
UPLOAD_DIR=./uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Correo (verificacion de usuarios)
# En desarrollo apunta a Mailpit; en produccion usa tu SMTP real.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@localspot.test
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# URL base del frontend usada para construir el enlace de verificacion
APP_BASE_URL=http://localhost:3000
VERIFICACION_EXPIRACION_MINUTOS=1440

# Mailpit (bandeja de correo de desarrollo)
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

# IA para motivos de recomendaciones (Google Gemini).
# Si AI_API_KEY queda vacia se usa el adaptador stub.
AI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-1.5-flash

# Google Maps Geocoding.
# Si MAPS_API_KEY queda vacia se usa el adaptador stub.
MAPS_API_KEY=
MAPS_API_URL=https://maps.googleapis.com/maps/api/geocode/json
# Centro por defecto (Fusagasuga, Colombia). Cambiar para operar en otra ciudad.
MAPS_DEFAULT_LAT=4.3372
MAPS_DEFAULT_LON=-74.3640
MAPS_DEFAULT_RADIO_KM=5
